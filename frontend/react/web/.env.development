# Tier-1 (fully-local) defaults for `npm run dev`.
# Vite loads this automatically in development. To point the local frontend at a
# remote dev backend (Tier 2), override these in a git-ignored .env.local.

VITE_APP_NAME=Pantry App (local)
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_AUTH_MODE=local
