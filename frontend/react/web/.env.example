# NOTE: For deployed tiers you normally do NOT hand-edit these — scripts/deploy-web.sh
# (and the deploy.yml CI job) read the values from Terraform outputs and inject them
# at build time. This file documents the variables and supports manual local builds.

# AWS Cognito Configuration (required in 'cognito' auth mode)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1

# Application Configuration
VITE_APP_NAME=Pantry App
VITE_APP_URL=http://localhost:5173

# Backend HTTP API base URL.
#   Tier 1 (fully local):   http://localhost:8000
#   Tier 2/3 (deployed):    https://xxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_GATEWAY_URL=http://localhost:8000

# Auth mode:
#   local   -> dev-bypass stub, no Cognito (Tier 1)
#   cognito -> real Amplify/Cognito session (Tier 2/3)
VITE_AUTH_MODE=cognito
